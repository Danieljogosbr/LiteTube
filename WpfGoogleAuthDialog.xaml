<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#0F0F0F"
      Margin="0">
    <Grid.Resources>
        <Style x:Key="AuthPillButton" TargetType="Button">
            <Setter Property="Background" Value="#1F1F1F"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D2D2D"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBlueButton" TargetType="Button" BasedOn="{StaticResource AuthPillButton}">
            <Setter Property="Background" Value="#3EA6FF"/>
            <Setter Property="Foreground" Value="#0F0F0F"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#65B8FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource AuthPillButton}">
            <Setter Property="Background" Value="#2A1618"/>
            <Setter Property="Foreground" Value="#FF6B6B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3E1E22"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Grid.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <TextBlock Text="Conta Google &amp; Sessão Segura" FontSize="20" FontWeight="Bold" Foreground="#F1F1F1"/>
            <TextBlock Text="Seus cookies ficam protegidos no Cofre Criptografado do Windows (DPAPI) e nunca são salvos em texto aberto."
                       FontSize="12.5" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,4,0,16"/>

            <!-- Status Card -->
            <Border Background="#1F1F1F" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock x:Name="LblStatusTitle" Text="Verificando sessão..." FontSize="14.5" FontWeight="Bold" Foreground="#F1F1F1"/>
                    <TextBlock x:Name="LblStatusDetail" Text="" FontSize="12.5" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <ProgressBar x:Name="ProgressBar" Height="4" IsIndeterminate="True" Visibility="Collapsed"
                                 Background="#2A2A2A" Foreground="#3EA6FF" BorderThickness="0" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- Primary Login -->
            <Button x:Name="BtnWebLogin" Content="🌐  Fazer Login Integrado (WebView2 Seguro)" Style="{StaticResource PrimaryBlueButton}" Height="42" Margin="0,0,0,16"/>

            <!-- Browser 1-click extraction -->
            <TextBlock Text="OU EXTRAIR DO NAVEGADOR (1 CLIQUE)" FontSize="11" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,8"/>
            <UniformGrid Columns="4" Margin="0,0,0,16">
                <Button x:Name="BtnExtractFirefox" Content="Firefox" Style="{StaticResource AuthPillButton}" Margin="0,0,6,0"/>
                <Button x:Name="BtnExtractChrome" Content="Chrome" Style="{StaticResource AuthPillButton}" Margin="3,0,3,0"/>
                <Button x:Name="BtnExtractEdge" Content="Edge" Style="{StaticResource AuthPillButton}" Margin="3,0,3,0"/>
                <Button x:Name="BtnExtractBrave" Content="Brave" Style="{StaticResource AuthPillButton}" Margin="6,0,0,0"/>
            </UniformGrid>

            <!-- Manual options -->
            <TextBlock Text="IMPORTAÇÃO MANUAL (NETSCAPE COOKIES)" FontSize="11" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,8"/>
            <UniformGrid Columns="2" Margin="0,0,0,20">
                <Button x:Name="BtnPasteClipboard" Content="📋  Colar Cookies" Style="{StaticResource AuthPillButton}" Margin="0,0,6,0"/>
                <Button x:Name="BtnImportCookies" Content="📁  Importar cookies.txt" Style="{StaticResource AuthPillButton}" Margin="6,0,0,0"/>
            </UniformGrid>

            <!-- Footer actions -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnClearAuth" Grid.Column="0" Content="Desconectar Conta" Style="{StaticResource DangerButton}"/>
                <Button x:Name="BtnClose" Grid.Column="2" Content="Fechar" Style="{StaticResource AuthPillButton}" MinWidth="100"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Grid>
