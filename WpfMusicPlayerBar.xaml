<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Name="RootMusicBarGrid"
      Background="#181818"
      Height="82">

    <Grid.RowDefinitions>
        <RowDefinition Height="14"/> <!-- Top-Edge Scrubber Hit Area -->
        <RowDefinition Height="*"/>  <!-- Main YT Music Bar Content -->
    </Grid.RowDefinitions>

    <!-- Scrubber de Borda Superior: 2px no topo (expande para 4px no hover), indicador vermelho e segmentos music_offtopic em azul/cinza -->
    <Grid Name="MusicScrubberHitArea"
          Grid.Row="0"
          Background="#01000000"
          Cursor="Hand"
          VerticalAlignment="Top"
          Height="14"
          Panel.ZIndex="15">

        <!-- Trilho de Fundo -->
        <Border Name="MusicScrubberBgTrack"
                Height="2"
                VerticalAlignment="Top"
                Background="#38FFFFFF"/>

        <!-- Segmentos music_offtopic do SponsorBlock em Azul/Cinza -->
        <Canvas Name="MusicOfftopicSegmentsCanvas"
                Height="2"
                VerticalAlignment="Top"
                ClipToBounds="True"
                IsHitTestVisible="False"/>

        <!-- Trilha Percorrida em Vermelho YouTube Music (#FF0000) -->
        <Border Name="MusicScrubberPlayedBar"
                Height="2"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Width="0"
                Background="#FF0000"/>

        <!-- Scrubber Thumb Circular Vermelho (Visível no Hover e Drag) -->
        <Canvas Name="MusicScrubberHeadCanvas"
                VerticalAlignment="Top"
                Height="14"
                IsHitTestVisible="False">
            <Ellipse Name="MusicScrubberThumb"
                     Width="12"
                     Height="12"
                     Fill="#FF0000"
                     Canvas.Top="-4"
                     Canvas.Left="-6"
                     Visibility="Collapsed"/>
        </Canvas>
    </Grid>

    <!-- Conteúdo Principal da Barra YT Music (Esquerda: Metadados | Centro: Transporte | Direita: Ações & Volume) -->
    <Grid Grid.Row="1" Margin="16,0,16,4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- ESQUERDA: Miniatura 48x48 Arredondada, Título/Artista com CharacterEllipsis e Botão Curtir -->
        <Grid Grid.Column="0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="42"/>
            </Grid.ColumnDefinitions>

            <!-- Capa 48x48 com Cantos Arredondados -->
            <Border Grid.Column="0"
                    Width="48"
                    Height="48"
                    CornerRadius="6"
                    Background="#262626"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    ClipToBounds="True">
                <Grid>
                    <TextBlock Text="♪"
                               Foreground="#777777"
                               FontSize="20"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    <Rectangle Name="ThumbImageRect"
                               Width="48"
                               Height="48"
                               RadiusX="6"
                               RadiusY="6"
                               Visibility="Collapsed">
                        <Rectangle.Fill>
                            <ImageBrush x:Name="ThumbImageBrush" Stretch="UniformToFill"/>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>
            </Border>

            <!-- Título e Artista com TextTrimming="CharacterEllipsis" -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,8,0">
                <TextBlock Name="TxtTrackTitle"
                           Text="Nenhuma música tocando"
                           Foreground="#F1F1F1"
                           FontFamily="Segoe UI Semibold"
                           FontSize="13.5"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="225"/>
                <TextBlock Name="TxtTrackArtist"
                           Text="Escolha uma faixa no catálogo"
                           Foreground="#AAAAAA"
                           FontFamily="Segoe UI"
                           FontSize="11.5"
                           Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="225"/>
            </StackPanel>

            <!-- Botão Curtir / Favoritar -->
            <Border Name="BtnLikeTrack"
                    Grid.Column="2"
                    Width="36"
                    Height="36"
                    CornerRadius="18"
                    Background="#01000000"
                    Cursor="Hand"
                    VerticalAlignment="Center"
                    ToolTip="Adicionar aos Favoritos">
                <Path Name="IconHeart"
                      Fill="#AAAAAA"
                      Stretch="Uniform"
                      Width="17"
                      Height="16"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Data="M12,21.35 L10.55,20.03 C5.4,15.36 2,12.27 2,8.5 C2,5.41 4.42,3 7.5,3 C9.24,3 10.91,3.81 12,5.08 C13.09,3.81 14.76,3 16.5,3 C19.58,3 22,5.41 22,8.5 C22,12.27 18.6,15.36 13.45,20.03 L12,21.35 Z"/>
            </Border>
        </Grid>

        <!-- CENTRO: Shuffle, Anterior, Play/Pause Circular em Destaque, Próxima e Repetir -->
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <!-- Botão Shuffle (Aleatório) -->
            <Border Name="BtnShuffle"
                    Width="38"
                    Height="38"
                    CornerRadius="19"
                    Background="#01000000"
                    Margin="4,0"
                    Cursor="Hand"
                    ToolTip="Modo Aleatório (Shuffle)">
                <Path Name="IconShuffle"
                      Fill="#9E9E9E"
                      Stretch="Uniform"
                      Width="16"
                      Height="16"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Data="M10.59,9.17 L5.41,4 L4,5.41 L9.17,10.58 L10.59,9.17 Z M14.5,4 L16.54,6.04 L4,18.59 L5.41,20 L17.96,7.46 L20,9.5 V4 H14.5 Z M14.83,13.41 L13.42,14.82 L16.55,17.95 L14.5,20 H20 V14.5 L17.96,16.54 L14.83,13.41 Z"/>
            </Border>

            <!-- Botão Faixa Anterior -->
            <Border Name="BtnPrevTrack"
                    Width="40"
                    Height="40"
                    CornerRadius="20"
                    Background="#01000000"
                    Margin="4,0"
                    Cursor="Hand"
                    ToolTip="Faixa Anterior">
                <Path Fill="#FFFFFF"
                      Stretch="Uniform"
                      Width="15"
                      Height="15"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Data="M6,6 H8 V18 H6 Z M9.5,12 L18,18 V6 L9.5,12 Z"/>
            </Border>

            <!-- Botão Play/Pause Circular em Destaque (Branco Oficial YT Music) -->
            <Border Name="BtnPlayPauseCircle"
                    Width="46"
                    Height="46"
                    CornerRadius="23"
                    Background="#FFFFFF"
                    Margin="10,0"
                    Cursor="Hand"
                    ToolTip="Reproduzir / Pausar">
                <Grid Width="22" Height="22">
                    <Path Name="IconMusicPlay"
                          Fill="#0F0F0F"
                          Stretch="Uniform"
                          Width="16"
                          Height="16"
                          Margin="2,0,0,0"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="M 6,4 L 20,12 L 6,20 Z"/>
                    <Path Name="IconMusicPause"
                          Fill="#0F0F0F"
                          Stretch="Uniform"
                          Width="15"
                          Height="16"
                          Visibility="Collapsed"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="M 6,4 H 10 V 20 H 6 Z M 14,4 H 18 V 20 H 14 Z"/>
                </Grid>
            </Border>

            <!-- Botão Próxima Faixa -->
            <Border Name="BtnNextTrack"
                    Width="40"
                    Height="40"
                    CornerRadius="20"
                    Background="#01000000"
                    Margin="4,0"
                    Cursor="Hand"
                    ToolTip="Próxima Faixa">
                <Path Fill="#FFFFFF"
                      Stretch="Uniform"
                      Width="15"
                      Height="15"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Data="M6,18 L14.5,12 L6,6 V18 Z M16,6 V18 H18 V6 H16 Z"/>
            </Border>

            <!-- Botão Repetir (Desligado / Todas / Uma) -->
            <Border Name="BtnRepeat"
                    Width="38"
                    Height="38"
                    CornerRadius="19"
                    Background="#01000000"
                    Margin="4,0"
                    Cursor="Hand"
                    ToolTip="Repetir (Desligado / Tudo / 1)">
                <Grid>
                    <Path Name="IconRepeat"
                          Fill="#9E9E9E"
                          Stretch="Uniform"
                          Width="16"
                          Height="16"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="M7,7 H17 V10 L21,6 L17,2 V5 H5 V11 H7 V7 Z M17,17 H7 V14 L3,18 L7,22 V19 H19 V13 H17 V17 Z"/>
                    <Border Name="BadgeRepeatOne"
                            Background="#FF0000"
                            CornerRadius="6"
                            Width="13"
                            Height="13"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,4,4,0"
                            Visibility="Collapsed">
                        <TextBlock Text="1"
                                   Foreground="White"
                                   FontFamily="Segoe UI Bold"
                                   FontSize="8.5"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>

        <!-- DIREITA: Tempo Decorrido/Total, Botão de Fila e Som com Slider Expansível 1:1 -->
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">

            <!-- Tempo Decorrido / Total -->
            <TextBlock Name="TxtMusicTime"
                       Text="0:00 / 0:00"
                       Foreground="#AAAAAA"
                       FontFamily="Segoe UI"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"/>

            <!-- Grupo de Volume Expansível -->
            <StackPanel Name="MusicVolumeHoverGroup"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Background="#01000000">

                <!-- Slider Expansível -->
                <Border Name="MusicVolumeExpandContainer"
                        Width="72"
                        Height="34"
                        ClipToBounds="True"
                        VerticalAlignment="Center">
                    <Grid Name="MusicVolumeHitGrid"
                          Width="64"
                          Height="34"
                          Margin="4,0,4,0"
                          Background="#01000000"
                          Cursor="Hand"
                          VerticalAlignment="Center">
                        <Border Height="3"
                                CornerRadius="1.5"
                                Background="#4DFFFFFF"
                                VerticalAlignment="Center"/>
                        <Border Name="MusicVolumeFillBar"
                                Height="3"
                                CornerRadius="1.5"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Width="30"
                                Background="#FFFFFF"/>
                        <Canvas VerticalAlignment="Center" Height="14" IsHitTestVisible="False">
                            <Ellipse Name="MusicVolumeThumb"
                                     Width="11"
                                     Height="11"
                                     Fill="#FFFFFF"
                                     Canvas.Top="1.5"
                                     Canvas.Left="24"/>
                        </Canvas>
                    </Grid>
                </Border>

                <!-- Ícone de Alto-falante -->
                <Border Name="BtnMusicMute"
                        Width="36"
                        Height="36"
                        CornerRadius="18"
                        Background="#01000000"
                        Cursor="Hand"
                        ToolTip="Mudo / Volume de Música">
                    <Grid Width="18" Height="18">
                        <Path Name="IconMusicSpeakerActive"
                              Fill="#FFFFFF"
                              Stretch="Uniform"
                              Width="17"
                              Height="16"
                              Data="M3,9 V15 H7 L12,20 V4 L7,9 H3 Z M16.5,12 C16.5,10.23 15.48,8.71 14,7.97 V16.02 C15.48,15.29 16.5,13.77 16.5,12 Z M14,3.23 V5.29 C16.89,6.15 19,8.83 19,12 C19,15.17 16.89,17.85 14,18.71 V20.77 C18.01,19.86 21,16.28 21,12 C21,7.72 18.01,4.14 14,3.23 Z"/>
                        <Path Name="IconMusicSpeakerMuted"
                              Fill="#FF5252"
                              Stretch="Uniform"
                              Width="17"
                              Height="16"
                              Visibility="Collapsed"
                              Data="M16.5,12 C16.5,10.23 15.48,8.71 14,7.97 V10.18 L16.45,12.63 C16.48,12.43 16.5,12.22 16.5,12 Z M19,12 C19,12.94 18.8,13.82 18.46,14.64 L19.97,16.15 C20.63,14.91 21,13.5 21,12 C21,7.72 18.01,4.14 14,3.23 V5.29 C16.89,6.15 19,8.83 19,12 Z M4.27,3 L3,4.27 L7.73,9 H3 V15 H7 L12,20 V13.27 L16.25,17.52 C15.58,18.04 14.83,18.45 14,18.7 V20.76 C15.38,20.45 16.63,19.81 17.69,18.95 L19.73,21 L21,19.73 L12,10.73 L4.27,3 Z M12,4 L9.91,6.09 L12,8.18 V4 Z"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Botão de Fila de Reprodução -->
            <Border Name="BtnQueueToggle"
                    Width="36"
                    Height="36"
                    CornerRadius="18"
                    Background="#01000000"
                    Margin="4,0,0,0"
                    Cursor="Hand"
                    ToolTip="Abrir Fila de Reprodução">
                <Path Fill="#FFFFFF"
                      Stretch="Uniform"
                      Width="17"
                      Height="15"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Data="M15,6 H3 V8 H15 V6 Z M15,10 H3 V12 H15 V10 Z M3,16 H11 V14 H3 V16 Z M17,6 V14.18 C16.69,14.07 16.35,14 16,14 C14.34,14 13,15.34 13,17 C13,18.66 14.34,20 16,20 C17.66,20 19,18.66 19,17 V8 H22 V6 H17 Z"/>
            </Border>
        </StackPanel>
    </Grid>
</Grid>
