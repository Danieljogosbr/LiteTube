<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8.1" />
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <!-- Workstation, non-concurrent GC: smaller heap and fewer background GC threads (lighter than a browser tab). -->
    <gcServer enabled="false" />
    <gcConcurrent enabled="false" />
    <!-- Delegação automática de protocolos TLS para o sistema operacional (TLS 1.2 e 1.3 nativos) -->
    <AppContextSwitchOverrides value="Switch.System.Net.DontEnableSystemDefaultTlsVersions=false" />
  </runtime>
  <!-- Suporte a DPI Moderno (PerMonitorV2) para Windows Forms no .NET 4.8 / 4.8.1 -->
  <System.Windows.Forms.ApplicationConfigurationSection>
    <add key="DpiAwareness" value="PerMonitorV2" />
    <add key="EnableWindowsFormsHighDpiAutoResizing" value="true" />
  </System.Windows.Forms.ApplicationConfigurationSection>
</configuration>
