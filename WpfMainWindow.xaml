<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#0F0F0F">
    <Grid.Resources>
        <Style x:Key="TopIconPillBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="18" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#242428"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EnvSwitchPill" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26262A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Grid.Resources>

    <Grid.RowDefinitions>
        <RowDefinition x:Name="TopBarRow" Height="56"/>
        <RowDefinition Height="*"/>
        <RowDefinition x:Name="StatusBarRow" Height="24"/>
    </Grid.RowDefinitions>

    <!-- YOUTUBE-FAITHFUL TOP BAR -->
    <Grid x:Name="TopHeaderBar" Grid.Row="0" Background="#0F0F0F" Margin="10,0,14,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Hamburger + LiteTube Brand + Env Switcher -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="BtnHamburger" Width="38" Height="38" Style="{StaticResource TopIconPillBtn}" ToolTip="Recolher / expandir barra lateral">
                <Path Data="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z" Fill="#F1F1F1" Width="18" Height="14" Stretch="Uniform"/>
            </Button>

            <StackPanel x:Name="BrandClickArea" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,14,0" Cursor="Hand">
                <Border Width="30" Height="21" CornerRadius="6" Background="#FF0033" VerticalAlignment="Center">
                    <Path Data="M 0,0 L 8,4.5 L 0,9 Z" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
                </Border>
                <TextBlock Text="LiteTube" FontSize="17" FontWeight="Bold" Foreground="#F1F1F1" VerticalAlignment="Center" Margin="7,0,0,1"/>
            </StackPanel>

            <Border Background="#1A1A1D" CornerRadius="16" Padding="3" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnEnvVideo" Content="YouTube" Style="{StaticResource EnvSwitchPill}"/>
                    <Button x:Name="BtnEnvMusic" Content="YT Music" Style="{StaticResource EnvSwitchPill}" Margin="2,0,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Center: YouTube Pill Search Box + Recent Search Dropdown -->
        <Grid Grid.Column="1" MaxWidth="560" Margin="20,0,20,0" VerticalAlignment="Center">
            <Border x:Name="SearchBarBorder" Height="38" CornerRadius="19" Background="#121212" BorderBrush="#2A2A2E" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="52"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtSearchPlaceholder" Text="Pesquisar" Foreground="#777777" FontSize="14"
                                   Margin="16,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBox x:Name="TxtSearchBox" Background="Transparent" BorderThickness="0"
                                 Foreground="#F1F1F1" CaretBrush="#F1F1F1" FontSize="14"
                                 Padding="16,0,6,0" VerticalContentAlignment="Center"/>
                    </Grid>

                    <Button x:Name="BtnClearSearch" Grid.Column="1" Content="✕" Width="28" Height="28" FontSize="12"
                            Foreground="#999999" Visibility="Collapsed" Style="{StaticResource TopIconPillBtn}"/>

                    <Border Grid.Column="2" Background="#222226" CornerRadius="0,18,18,0">
                        <Button x:Name="BtnSearchGo" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Pesquisar">
                            <Path Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                  Fill="#D4D4D8" Width="17" Height="17" Stretch="Uniform"/>
                        </Button>
                    </Border>
                </Grid>
            </Border>

            <Popup x:Name="SearchHistoryPopup" PlacementTarget="{Binding ElementName=SearchBarBorder}"
                   Placement="Bottom" VerticalOffset="4" StaysOpen="False" AllowsTransparency="True">
                <Border Background="#1B1B1F" BorderBrush="#2E2E34" BorderThickness="1" CornerRadius="12" Padding="6"
                        Width="{Binding ActualWidth, ElementName=SearchBarBorder}">
                    <StackPanel x:Name="SearchHistoryItemsPanel"/>
                </Border>
            </Popup>
        </Grid>

        <!-- Right: Refresh + Live RAM + Google Account Pill with Circular Avatar -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="BtnRefresh" Width="36" Height="36" Style="{StaticResource TopIconPillBtn}" ToolTip="Atualizar página atual" Margin="0,0,6,0">
                <Path Data="M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                      Fill="#D4D4D8" Width="17" Height="17" Stretch="Uniform"/>
            </Button>

            <Border Background="#18181B" CornerRadius="14" Padding="10,5" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Consumo real de memória RAM física (Private Working Set)">
                <TextBlock x:Name="LblRamUsage" Text="-- MB" FontSize="12" FontWeight="SemiBold" Foreground="#4ADE80"/>
            </Border>

            <Button x:Name="BtnGoogleAccount" Height="36" Padding="8,0,12,0" Background="#1F1F1F" Style="{StaticResource TopIconPillBtn}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="AccountAvatarEllipse" Width="24" Height="24" Fill="#2E2E34" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtGoogleAccountName" Text="Conta Google" FontSize="12.5" FontWeight="SemiBold" Foreground="#F1F1F1" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>

    <!-- MAIN ENVIRONMENT HOST (YouTube Video / YouTube Music) -->
    <Grid Grid.Row="1">
        <ContentControl x:Name="VideoEnvironmentHost" Visibility="Visible"/>
        <ContentControl x:Name="MusicEnvironmentHost" Visibility="Collapsed"/>
    </Grid>

    <!-- FIXED SUBTLE BOTTOM STATUS BAR (24px) -->
    <Grid x:Name="BottomStatusBar" Grid.Row="2" Background="#0A0A0C" Margin="14,0,14,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="LblStatusText" Grid.Column="0" Text="LiteTube pronto." FontSize="11.5" Foreground="#8A8A92" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="LblGpuStatus" Grid.Column="1" Text="Flyleaf D3D11" FontSize="11" Foreground="#666670" VerticalAlignment="Center" Margin="12,0,0,0"/>
    </Grid>
</Grid>
