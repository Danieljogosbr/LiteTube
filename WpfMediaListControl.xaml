<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=LiteTube"
             Background="#0F0F0F"
             Foreground="#F1F1F1"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             Focusable="True">

    <UserControl.Resources>
        <!-- ScrollBar Thumbs -->
        <Style x:Key="LiteTubeScrollThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder" Background="#45FFFFFF" CornerRadius="4" Margin="1,0,1,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#85FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#B5FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark Slim ScrollBar (YouTube / OLED style) -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource LiteTubeScrollThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean ListBoxItem without default blue selection border -->
        <Style x:Key="LiteTubeListBoxItem" TargetType="{x:Type ListBoxItem}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- =================================================================== -->
        <!-- 1. GRID ROW TEMPLATE: Virtualized rows containing 1-4 video cards   -->
        <!-- =================================================================== -->
        <DataTemplate x:Key="GridRowTemplate">
            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="{Binding CardWidth}" Height="{Binding CardHeight}"
                                CornerRadius="12" Background="{Binding BackgroundBrush}" Margin="8,8"
                                Tag="Card" Cursor="Hand" BorderThickness="0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1F1F1F"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <!-- ================= 1A. NORMAL VIDEO CARD ================= -->
                                <Grid Visibility="{Binding VideoVisibility}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- 16:9 Thumbnail Container (border-radius 12px) -->
                                    <Border Grid.Row="0" Height="{Binding ThumbHeight}" CornerRadius="12"
                                            ClipToBounds="True" Background="#1F1F1F">
                                        <Grid>
                                            <Image Source="{Binding ThumbnailSource}" Stretch="UniformToFill"/>
                                            <!-- Fallback Icon if thumb not loaded -->
                                            <TextBlock Text="{Binding PlaceholderIcon}" Foreground="#52525B" FontSize="26"
                                                       FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding FallbackVisibility}"/>
                                            <!-- Duration Badge Translucent -->
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8"
                                                    Background="#CC0F0F0F" CornerRadius="6" Padding="6,2,6,2"
                                                    Visibility="{Binding DurationVisibility}">
                                                <TextBlock Text="{Binding Duration}" Foreground="#F1F1F1" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                            <!-- Local History Resume Progress Bar -->
                                            <Border VerticalAlignment="Bottom" Height="3" Background="#60000000" Visibility="{Binding ProgressVisibility}">
                                                <Border Background="#FF0033" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="{Binding WatchProgressRatio}"/>
                                                    </Border.RenderTransform>
                                                </Border>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Bottom Info: Avatar + Title + Channel + Views/Date + Actions -->
                                    <Grid Grid.Row="1" Margin="6,10,6,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Channel Avatar Circle -->
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" VerticalAlignment="Top"
                                                Background="{Binding AvatarBrush}" Margin="0,2,10,0" Tag="Channel" Cursor="Hand" ClipToBounds="True">
                                            <Grid>
                                                <TextBlock Text="{Binding AvatarInitial}" Foreground="#F1F1F1" FontWeight="Bold" FontSize="13.5"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding AvatarFallbackVisibility}"/>
                                                <Ellipse Width="36" Height="36" Visibility="{Binding AvatarImageVisibility}">
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{Binding ChannelAvatarSource}" Stretch="UniformToFill"/>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </Grid>
                                        </Border>

                                        <!-- Title, Channel Name and Views/Date -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" MaxHeight="38"
                                                       TextTrimming="CharacterEllipsis" FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{Binding TitleBrush}" LineHeight="18"/>
                                            <TextBlock Text="{Binding Artist}" TextTrimming="CharacterEllipsis" Foreground="#AAAAAA"
                                                       FontSize="12" Margin="0,3,0,0" Tag="Channel" Cursor="Hand"/>
                                            <TextBlock Text="{Binding ViewsAndDateText}" TextTrimming="CharacterEllipsis" Foreground="#AAAAAA"
                                                       FontSize="11.5" Margin="0,1,0,0" Visibility="{Binding ViewsAndDateVisibility}"/>
                                        </StackPanel>

                                        <!-- Quick Action Buttons: +Fila & Favorite -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="4,0,0,0">
                                            <Border Tag="Queue" Padding="7,3" Background="#1AFFFFFF" CornerRadius="12" Margin="0,0,4,0"
                                                    Cursor="Hand" Visibility="{Binding QueueButtonVisibility}" ToolTip="Assistir a seguir (adicionar à fila)">
                                                <TextBlock Text="+Fila" Foreground="#F1F1F1" FontSize="10.5" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border Padding="4" Background="Transparent" Tag="Favorite" Cursor="Hand" Visibility="{Binding FavoriteButtonVisibility}">
                                                <TextBlock Text="{Binding FavoriteIcon}" Foreground="{Binding FavoriteBrush}" FontSize="15"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Grid>

                                <!-- ================= 1B. CHANNEL BANNER CARD ================= -->
                                <Grid Visibility="{Binding ChannelVisibility}" Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Centered Big Avatar with Ring -->
                                    <Border Grid.Row="0" Width="80" Height="80" CornerRadius="40" Background="{Binding AvatarBrush}"
                                            HorizontalAlignment="Center" Margin="0,16,0,10" BorderBrush="#3EA6FF" BorderThickness="2"
                                            Tag="Channel" Cursor="Hand">
                                        <Grid>
                                            <TextBlock Text="{Binding AvatarInitial}" Foreground="White" FontWeight="Bold" FontSize="26"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding AvatarFallbackVisibility}"/>
                                            <Ellipse Width="76" Height="76" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                     Visibility="{Binding AvatarImageVisibility}">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding ChannelAvatarSource}" Stretch="UniformToFill"/>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                        </Grid>
                                    </Border>

                                    <!-- Channel Title + Checkmark -->
                                    <TextBlock Grid.Row="1" Text="{Binding ChannelDisplayTitle}" Foreground="#F4F4F5"
                                               FontWeight="Bold" FontSize="15" HorizontalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Margin="0,4,0,2"/>

                                    <!-- Subtitle / Subscribers -->
                                    <TextBlock Grid.Row="2" Text="{Binding Artist}" Foreground="#A1A1AA" FontSize="12"
                                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,14"/>

                                    <!-- Access Channel Pill Button -->
                                    <Border Grid.Row="3" Background="#F4F4F5" CornerRadius="16" Height="32" Width="140"
                                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"
                                            Tag="Channel" Cursor="Hand">
                                        <TextBlock Text="Acessar Canal" Foreground="#0F0F11" FontWeight="SemiBold"
                                                   FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <!-- =================================================================== -->
        <!-- 2. SIDEBAR COMPACT TEMPLATE: YouTube Watch page right sidebar        -->
        <!-- =================================================================== -->
        <DataTemplate x:Key="SidebarItemTemplate">
            <Border CornerRadius="8" Background="{Binding BackgroundBrush}" Margin="2,3" Padding="4"
                    Tag="Card" Cursor="Hand" BorderThickness="{Binding BorderThickness}" BorderBrush="{Binding BorderBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#222226"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 16:9 Thumbnail (136 x 76) -->
                    <Border Grid.Column="0" Width="136" Height="76" CornerRadius="6" ClipToBounds="True" Background="#18181B">
                        <Grid>
                            <Image Source="{Binding ThumbnailSource}" Stretch="UniformToFill"/>
                            <TextBlock Text="{Binding PlaceholderIcon}" Foreground="#52525B" FontSize="20"
                                       FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding FallbackVisibility}"/>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4"
                                    Background="{Binding DurationBadgeBackground}" CornerRadius="4" Padding="4,1,4,1"
                                    Visibility="{Binding DurationVisibility}">
                                <TextBlock Text="{Binding Duration}" Foreground="#F4F4F5" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                            <!-- Local History Progress Bar -->
                            <Border VerticalAlignment="Bottom" Height="2" Background="#60000000" Visibility="{Binding ProgressVisibility}">
                                <Border Background="#3EA6FF" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform ScaleX="{Binding WatchProgressRatio}"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Metadata: Title & Channel Name -->
                    <StackPanel Grid.Column="1" Margin="10,2,4,2">
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis"
                                   FontWeight="SemiBold" FontSize="12.5" Foreground="{Binding TitleBrush}" LineHeight="17"/>
                        <TextBlock Text="{Binding Artist}" TextTrimming="CharacterEllipsis" Foreground="#A1A1AA"
                                   FontSize="11.5" Margin="0,4,0,0" Tag="Channel" Cursor="Hand"/>
                    </StackPanel>

                    <!-- Quick Actions: +Fila & Favorite -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Padding="5,2" Background="#222226" BorderBrush="#27272A" BorderThickness="1" CornerRadius="4" Margin="2,0,2,0"
                                Tag="Queue" Cursor="Hand" Visibility="{Binding QueueButtonVisibility}" ToolTip="Assistir a seguir (adicionar à fila)">
                            <TextBlock Text="+Fila" Foreground="#F4F4F5" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                        <Border VerticalAlignment="Center" Padding="5" Background="Transparent"
                                Tag="Favorite" Cursor="Hand" Visibility="{Binding FavoriteButtonVisibility}">
                            <TextBlock Text="{Binding FavoriteIcon}" Foreground="{Binding FavoriteBrush}" FontSize="15"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- =================================================================== -->
        <!-- 3. MUSIC ROW TEMPLATE: YouTube Music track list row                  -->
        <!-- =================================================================== -->
        <DataTemplate x:Key="MusicRowTemplate">
            <Border CornerRadius="8" Background="{Binding BackgroundBrush}" Margin="4,2" Padding="4,5"
                    Tag="Card" Cursor="Hand" BorderThickness="{Binding BorderThickness}" BorderBrush="{Binding BorderBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#222226"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="82"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Track Index or Playing Indicator -->
                    <TextBlock Grid.Column="0" Text="{Binding TrackIndicator}" Foreground="{Binding IndicatorBrush}"
                               FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <!-- Thumbnail Container (78 x 46) -->
                    <Border Grid.Column="1" Width="78" Height="46" CornerRadius="4" ClipToBounds="True" Background="#18181B">
                        <Grid>
                            <Image Source="{Binding ThumbnailSource}" Stretch="UniformToFill"/>
                            <TextBlock Text="{Binding PlaceholderIcon}" Foreground="#52525B" FontSize="18"
                                       FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding FallbackVisibility}"/>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3"
                                    Background="{Binding DurationBadgeBackground}" CornerRadius="3" Padding="3,1,3,1"
                                    Visibility="{Binding DurationVisibility}">
                                <TextBlock Text="{Binding Duration}" Foreground="#F4F4F5" FontSize="10" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Title & Artist / Duration Subtitle -->
                    <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"
                                   FontSize="13" Foreground="{Binding TitleBrush}"/>
                        <TextBlock Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" Foreground="#A1A1AA"
                                   FontSize="11.5" Margin="0,3,0,0" Tag="Channel" Cursor="Hand"/>
                    </StackPanel>

                    <!-- Quick Action Buttons -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Border Tag="Favorite" Padding="6,4" Background="Transparent" Margin="2,0" Cursor="Hand"
                                Visibility="{Binding FavoriteButtonVisibility}">
                            <TextBlock Text="{Binding FavoriteIcon}" Foreground="{Binding FavoriteBrush}" FontSize="14"/>
                        </Border>
                        <Border Tag="Queue" Padding="8,4" Background="#222226" BorderBrush="#27272A" BorderThickness="1" CornerRadius="4" Margin="4,0" Cursor="Hand"
                                Visibility="{Binding QueueButtonVisibility}">
                            <TextBlock Text="+Fila" Foreground="#F4F4F5" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <Border Tag="Video" Padding="6,4" Background="#182C46" BorderBrush="#27272A" BorderThickness="1" CornerRadius="4" Margin="4,0" Cursor="Hand"
                                Visibility="{Binding VideoButtonVisibility}">
                            <TextBlock Text="🎬" Foreground="#3EA6FF" FontSize="12"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Main Container Grid -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Hardware-Accelerated Virtualized ListBox -->
        <ListBox Grid.Row="0" x:Name="MediaListBox"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="4"
                 Focusable="True"
                 ItemContainerStyle="{StaticResource LiteTubeListBoxItem}"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 ScrollViewer.CanContentScroll="True"
                 ScrollViewer.PanningMode="VerticalOnly"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>

        <!-- Load More Footer (Visible when HasMoreItems or IsLoadingMore) -->
        <Border Grid.Row="1" x:Name="FooterPanel" Height="42" Margin="10,8" Background="#18181B"
                BorderBrush="#27272A" BorderThickness="1"
                CornerRadius="21" HorizontalAlignment="Center" Padding="24,0" Tag="LoadMore" Cursor="Hand"
                Visibility="Collapsed">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#222226"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock x:Name="FooterText" Text="➕ Carregar mais vídeos (ou continue rolando)"
                       Foreground="#F4F4F5" FontSize="12.5" FontWeight="SemiBold"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>

        <!-- Skeleton Loader Overlay (GPU Opacity 0.4 <-> 0.85 loop) -->
        <Grid Grid.Row="0" x:Name="SkeletonOverlay" Visibility="Collapsed" IsHitTestVisible="False" Background="#0F0F0F">
            <WrapPanel x:Name="SkeletonGridContainer" Margin="8" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed">
                <Border Width="310" Height="254" Margin="8,10" CornerRadius="8" Background="#18181B" BorderBrush="#27272A" BorderThickness="1">
                    <StackPanel>
                        <Border Height="174" CornerRadius="8,8,0,0" Background="#222226"/>
                        <StackPanel Orientation="Horizontal" Margin="10,10,10,0">
                            <Border Width="38" Height="38" CornerRadius="19" Background="#222226" Margin="0,0,10,0"/>
                            <StackPanel Width="230" VerticalAlignment="Center">
                                <Border Height="12" CornerRadius="4" Background="#222226" Margin="0,0,0,8"/>
                                <Border Height="10" Width="150" HorizontalAlignment="Left" CornerRadius="4" Background="#222226"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Width="310" Height="254" Margin="8,10" CornerRadius="8" Background="#18181B" BorderBrush="#27272A" BorderThickness="1">
                    <StackPanel>
                        <Border Height="174" CornerRadius="8,8,0,0" Background="#222226"/>
                        <StackPanel Orientation="Horizontal" Margin="10,10,10,0">
                            <Border Width="38" Height="38" CornerRadius="19" Background="#222226" Margin="0,0,10,0"/>
                            <StackPanel Width="230" VerticalAlignment="Center">
                                <Border Height="12" CornerRadius="4" Background="#222226" Margin="0,0,0,8"/>
                                <Border Height="10" Width="170" HorizontalAlignment="Left" CornerRadius="4" Background="#222226"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Width="310" Height="254" Margin="8,10" CornerRadius="8" Background="#18181B" BorderBrush="#27272A" BorderThickness="1">
                    <StackPanel>
                        <Border Height="174" CornerRadius="8,8,0,0" Background="#222226"/>
                        <StackPanel Orientation="Horizontal" Margin="10,10,10,0">
                            <Border Width="38" Height="38" CornerRadius="19" Background="#222226" Margin="0,0,10,0"/>
                            <StackPanel Width="230" VerticalAlignment="Center">
                                <Border Height="12" CornerRadius="4" Background="#222226" Margin="0,0,0,8"/>
                                <Border Height="10" Width="140" HorizontalAlignment="Left" CornerRadius="4" Background="#222226"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Width="310" Height="254" Margin="8,10" CornerRadius="8" Background="#18181B" BorderBrush="#27272A" BorderThickness="1">
                    <StackPanel>
                        <Border Height="174" CornerRadius="8,8,0,0" Background="#222226"/>
                        <StackPanel Orientation="Horizontal" Margin="10,10,10,0">
                            <Border Width="38" Height="38" CornerRadius="19" Background="#222226" Margin="0,0,10,0"/>
                            <StackPanel Width="230" VerticalAlignment="Center">
                                <Border Height="12" CornerRadius="4" Background="#222226" Margin="0,0,0,8"/>
                                <Border Height="10" Width="165" HorizontalAlignment="Left" CornerRadius="4" Background="#222226"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Width="310" Height="254" Margin="8,10" CornerRadius="8" Background="#18181B" BorderBrush="#27272A" BorderThickness="1">
                    <StackPanel>
                        <Border Height="174" CornerRadius="8,8,0,0" Background="#222226"/>
                        <StackPanel Orientation="Horizontal" Margin="10,10,10,0">
                            <Border Width="38" Height="38" CornerRadius="19" Background="#222226" Margin="0,0,10,0"/>
                            <StackPanel Width="230" VerticalAlignment="Center">
                                <Border Height="12" CornerRadius="4" Background="#222226" Margin="0,0,0,8"/>
                                <Border Height="10" Width="135" HorizontalAlignment="Left" CornerRadius="4" Background="#222226"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Width="310" Height="254" Margin="8,10" CornerRadius="8" Background="#18181B" BorderBrush="#27272A" BorderThickness="1">
                    <StackPanel>
                        <Border Height="174" CornerRadius="8,8,0,0" Background="#222226"/>
                        <StackPanel Orientation="Horizontal" Margin="10,10,10,0">
                            <Border Width="38" Height="38" CornerRadius="19" Background="#222226" Margin="0,0,10,0"/>
                            <StackPanel Width="230" VerticalAlignment="Center">
                                <Border Height="12" CornerRadius="4" Background="#222226" Margin="0,0,0,8"/>
                                <Border Height="10" Width="155" HorizontalAlignment="Left" CornerRadius="4" Background="#222226"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <StackPanel x:Name="SkeletonSidebarContainer" Margin="8" Visibility="Collapsed">
                <Border Margin="2,3" Padding="4" CornerRadius="8" Background="#18181B" BorderBrush="#27272A" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="136" Height="76" CornerRadius="6" Background="#222226"/>
                        <StackPanel Grid.Column="1" Margin="10,6,6,6">
                            <Border Height="12" CornerRadius="4" Background="#222226" Margin="0,0,0,8"/>
                            <Border Height="10" Width="110" HorizontalAlignment="Left" CornerRadius="4" Background="#222226"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Margin="2,3" Padding="4" CornerRadius="8" Background="#18181B" BorderBrush="#27272A" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="136" Height="76" CornerRadius="6" Background="#222226"/>
                        <StackPanel Grid.Column="1" Margin="10,6,6,6">
                            <Border Height="12" CornerRadius="4" Background="#222226" Margin="0,0,0,8"/>
                            <Border Height="10" Width="95" HorizontalAlignment="Left" CornerRadius="4" Background="#222226"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Margin="2,3" Padding="4" CornerRadius="8" Background="#18181B" BorderBrush="#27272A" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="136" Height="76" CornerRadius="6" Background="#222226"/>
                        <StackPanel Grid.Column="1" Margin="10,6,6,6">
                            <Border Height="12" CornerRadius="4" Background="#222226" Margin="0,0,0,8"/>
                            <Border Height="10" Width="125" HorizontalAlignment="Left" CornerRadius="4" Background="#222226"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Margin="2,3" Padding="4" CornerRadius="8" Background="#18181B" BorderBrush="#27272A" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="136" Height="76" CornerRadius="6" Background="#222226"/>
                        <StackPanel Grid.Column="1" Margin="10,6,6,6">
                            <Border Height="12" CornerRadius="4" Background="#222226" Margin="0,0,0,8"/>
                            <Border Height="10" Width="105" HorizontalAlignment="Left" CornerRadius="4" Background="#222226"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Margin="2,3" Padding="4" CornerRadius="8" Background="#18181B" BorderBrush="#27272A" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="136" Height="76" CornerRadius="6" Background="#222226"/>
                        <StackPanel Grid.Column="1" Margin="10,6,6,6">
                            <Border Height="12" CornerRadius="4" Background="#222226" Margin="0,0,0,8"/>
                            <Border Height="10" Width="115" HorizontalAlignment="Left" CornerRadius="4" Background="#222226"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Empty State Message -->
        <Border Grid.Row="0" x:Name="EmptyStatePanel" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Center"
                VerticalAlignment="Center" Margin="24">
            <TextBlock x:Name="EmptyStateText" Text="Pesquise vídeos, canais ou músicas na barra de busca superior do YouTube."
                       Foreground="#A1A1AA" FontSize="13.5" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="440" LineHeight="20"/>
        </Border>
    </Grid>
</UserControl>
