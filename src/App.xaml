<Application x:Class="LiteTube.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Paleta WinUI 3 Escura Padronizada (Superfícies sólidas, bordas 1px, sem DropShadowEffect) -->
            <Color x:Key="WinUiWindowBgColor">#0F0F11</Color>
            <Color x:Key="WinUiSurfaceElevatedColor">#18181B</Color>
            <Color x:Key="WinUiHoverHighlightColor">#222226</Color>
            <Color x:Key="WinUiBorderColor">#27272A</Color>
            <Color x:Key="WinUiTextPrimaryColor">#F4F4F5</Color>
            <Color x:Key="WinUiTextSecondaryColor">#A1A1AA</Color>
            <Color x:Key="WinUiAccentColor">#3EA6FF</Color>

            <SolidColorBrush x:Key="WinUiWindowBgBrush" Color="#0F0F11"/>
            <SolidColorBrush x:Key="WinUiSurfaceElevatedBrush" Color="#18181B"/>
            <SolidColorBrush x:Key="WinUiHoverHighlightBrush" Color="#222226"/>
            <SolidColorBrush x:Key="WinUiBorderBrush" Color="#27272A"/>
            <SolidColorBrush x:Key="WinUiTextPrimaryBrush" Color="#F4F4F5"/>
            <SolidColorBrush x:Key="WinUiTextSecondaryBrush" Color="#A1A1AA"/>
            <SolidColorBrush x:Key="WinUiAccentBrush" Color="#3EA6FF"/>

            <FontFamily x:Key="WinUiFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>

            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
                <Setter Property="Foreground" Value="#F4F4F5"/>
            </Style>

            <Style TargetType="{x:Type Control}">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
