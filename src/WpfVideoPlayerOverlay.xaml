<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Name="RootOverlayGrid"
      Background="#01000000"
      Focusable="True">

    <!-- Banner de Notificação Toast Geral (Qualidade, Status, etc.) -->
    <Border Name="ToastNotificationBanner"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="24,24,0,0"
            Padding="14,8"
            CornerRadius="6"
            Background="#E6121212"
            BorderBrush="#3EA6FF"
            BorderThickness="1.5"
            Visibility="Collapsed"
            IsHitTestVisible="False"
            Panel.ZIndex="50">
        <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="#3EA6FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Name="ToastNotificationText"
                       Text="Qualidade alterada"
                       Foreground="#FFFFFF"
                       FontFamily="Segoe UI Semibold"
                       FontSize="12.5"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Border>

    <!-- Banner Discreto do SponsorBlock no Canto Inferior Direito ("Patrocínio pulado") -->
    <Border Name="SponsorSkipBanner"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,22,82"
            Padding="14,8"
            CornerRadius="6"
            Background="#D9121212"
            BorderBrush="#00D600"
            BorderThickness="1.5"
            Visibility="Collapsed"
            IsHitTestVisible="False"
            Panel.ZIndex="20">
        <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="#00D600" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Name="SponsorSkipBannerText"
                       Text="Patrocínio pulado"
                       Foreground="#FFFFFF"
                       FontFamily="Segoe UI Semibold"
                       FontSize="12.5"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Border>

    <!-- Painel Flutuante de Configurações (Engrenagem: Qualidade e Velocidade) -->
    <Border Name="GearPopupPanel"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,18,64"
            Width="260"
            Padding="12"
            CornerRadius="8"
            Background="#F2181818"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Visibility="Collapsed"
            Panel.ZIndex="30">
        <StackPanel>
            <TextBlock Text="QUALIDADE DO VÍDEO" Foreground="#AAAAAA" FontFamily="Segoe UI Semibold" FontSize="10.5" Margin="2,0,0,6"/>
            <UniformGrid Columns="4" Margin="0,0,0,12">
                <Button Name="BtnGearQ144" Content="144p" Height="28" Margin="2" Background="#282828" Foreground="White" BorderThickness="0" Cursor="Hand" FontFamily="Segoe UI Semibold" FontSize="11"/>
                <Button Name="BtnGearQ240" Content="240p" Height="28" Margin="2" Background="#282828" Foreground="White" BorderThickness="0" Cursor="Hand" FontFamily="Segoe UI Semibold" FontSize="11"/>
                <Button Name="BtnGearQ360" Content="360p" Height="28" Margin="2" Background="#282828" Foreground="White" BorderThickness="0" Cursor="Hand" FontFamily="Segoe UI Semibold" FontSize="11"/>
                <Button Name="BtnGearQ480" Content="480p" Height="28" Margin="2" Background="#282828" Foreground="White" BorderThickness="0" Cursor="Hand" FontFamily="Segoe UI Semibold" FontSize="11"/>
                <Button Name="BtnGearQ720" Content="720p" Height="28" Margin="2" Background="#FF0000" Foreground="White" BorderThickness="0" Cursor="Hand" FontFamily="Segoe UI Semibold" FontSize="11"/>
                <Button Name="BtnGearQ1080" Content="1080p" Height="28" Margin="2" Background="#282828" Foreground="White" BorderThickness="0" Cursor="Hand" FontFamily="Segoe UI Semibold" FontSize="11"/>
                <Button Name="BtnGearQ1440" Content="1440p" Height="28" Margin="2" Background="#282828" Foreground="White" BorderThickness="0" Cursor="Hand" FontFamily="Segoe UI Semibold" FontSize="11"/>
                <Button Name="BtnGearQ2160" Content="4K" Height="28" Margin="2" Background="#282828" Foreground="White" BorderThickness="0" Cursor="Hand" FontFamily="Segoe UI Semibold" FontSize="11"/>
            </UniformGrid>

            <TextBlock Text="VELOCIDADE DE REPRODUÇÃO" Foreground="#AAAAAA" FontFamily="Segoe UI Semibold" FontSize="10.5" Margin="2,0,0,6"/>
            <UniformGrid Columns="5" Margin="0,0,0,10">
                <Button Name="BtnGearSpd075" Content="0.75x" Height="26" Margin="1.5" Background="#282828" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="10.5"/>
                <Button Name="BtnGearSpd100" Content="1.0x" Height="26" Margin="1.5" Background="#FF0000" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="10.5"/>
                <Button Name="BtnGearSpd125" Content="1.25x" Height="26" Margin="1.5" Background="#282828" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="10.5"/>
                <Button Name="BtnGearSpd150" Content="1.5x" Height="26" Margin="1.5" Background="#282828" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="10.5"/>
                <Button Name="BtnGearSpd200" Content="2.0x" Height="26" Margin="1.5" Background="#282828" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="10.5"/>
            </UniformGrid>

            <Button Name="BtnGearAudioDialog"
                    Content="Regulador Avançado de Áudio"
                    Height="30"
                    Margin="2,2,2,0"
                    Background="#282828"
                    Foreground="#EAEAEA"
                    BorderThickness="0"
                    Cursor="Hand"
                    FontFamily="Segoe UI Semibold"
                    FontSize="11.5"/>
        </StackPanel>
    </Border>

    <!-- Painel de Controles Inferior (YouTube Skin com Auto-Hide via DoubleAnimation) -->
    <Grid Name="ControlsContainerGrid"
          VerticalAlignment="Bottom"
          Height="96"
          Opacity="1.0"
          Panel.ZIndex="10">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#00000000" Offset="0.0"/>
                <GradientStop Color="#99000000" Offset="0.45"/>
                <GradientStop Color="#E6080808" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="30"/> <!-- Tooltip Row -->
            <RowDefinition Height="18"/> <!-- Scrubber Row -->
            <RowDefinition Height="48"/> <!-- Buttons Row -->
        </Grid.RowDefinitions>

        <!-- Tooltip Flutuante Escuro com Cantos Arredondados na Barra de Progresso -->
        <Canvas Name="TooltipCanvas" Grid.Row="0" IsHitTestVisible="False">
            <Border Name="ScrubberTooltipBorder"
                    Background="#E6161616"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="7,3"
                    Visibility="Collapsed"
                    Canvas.Top="2">
                <TextBlock Name="ScrubberTooltipText"
                           Text="0:00"
                           Foreground="#FFFFFF"
                           FontFamily="Segoe UI Semibold"
                           FontSize="11.5"/>
            </Border>
        </Canvas>

        <!-- Barra de Progresso (Scrubber) Estilo YouTube -->
        <Grid Name="ScrubberHitArea"
              Grid.Row="1"
              Margin="14,0,14,0"
              Background="#01000000"
              Cursor="Hand"
              VerticalAlignment="Center"
              Height="18">

            <!-- Trilho de Fundo Cinza Escuro Translúcido -->
            <Border Name="ScrubberBgTrack"
                    Height="3"
                    VerticalAlignment="Center"
                    CornerRadius="1.5"
                    Background="#4DFFFFFF"/>

            <!-- Barra de Buffer Cinza Claro Indicando o Cache Carregado -->
            <Border Name="ScrubberBufferBar"
                    Height="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    CornerRadius="1.5"
                    Width="0"
                    Background="#8CFFFFFF"/>

            <!-- Hover Preview Bar -->
            <Border Name="ScrubberHoverBar"
                    Height="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    CornerRadius="1.5"
                    Width="0"
                    Background="#59FFFFFF"
                    Visibility="Collapsed"/>

            <!-- Segmentos Coloridos do SponsorBlock Sobrepostos na Trilha -->
            <Canvas Name="SponsorSegmentsCanvas"
                    Height="3"
                    VerticalAlignment="Center"
                    ClipToBounds="True"
                    IsHitTestVisible="False"/>

            <!-- Barra de Tempo Percorrido em Vermelho Oficial do YouTube (#FF0000) -->
            <Border Name="ScrubberPlayedBar"
                    Height="3"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    CornerRadius="1.5"
                    Width="0"
                    Background="#FF0000"/>

            <!-- Scrubber Head (Círculo Vermelho de Arraste Visível no Hover e Durante o Drag) -->
            <Canvas Name="ScrubberHeadCanvas"
                    VerticalAlignment="Center"
                    Height="18"
                    IsHitTestVisible="False">
                <Ellipse Name="ScrubberThumbHead"
                         Width="13"
                         Height="13"
                         Fill="#FF0000"
                         Canvas.Top="2.5"
                         Canvas.Left="-6.5"
                         Visibility="Collapsed"/>
            </Canvas>
        </Grid>

        <!-- Linha Inferior de Controles e Ícones Vetoriais Path XAML -->
        <Grid Grid.Row="2" Margin="10,0,10,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Controles da Esquerda: Play/Pause, Próximo, Volume com Slider Expansível, Rótulo de Tempo -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Play / Pause Button -->
                <Border Name="BtnPlayPause" Width="40" Height="38" Background="#01000000" CornerRadius="19" Cursor="Hand" ToolTip="Reproduzir / Pausar (K ou Espaço)">
                    <Grid Width="22" Height="22">
                        <Path Name="IconPlay"
                              Fill="#FFFFFF"
                              Stretch="Uniform"
                              Width="16" Height="16"
                              Data="M 6,4 L 20,12 L 6,20 Z"/>
                        <Path Name="IconPause"
                              Fill="#FFFFFF"
                              Stretch="Uniform"
                              Width="15" Height="16"
                              Visibility="Collapsed"
                              Data="M 6,4 H 10 V 20 H 6 Z M 14,4 H 18 V 20 H 14 Z"/>
                    </Grid>
                </Border>

                <!-- Próximo Vídeo Button -->
                <Border Name="BtnNextVideo" Width="38" Height="38" Background="#01000000" CornerRadius="19" Cursor="Hand" ToolTip="Próximo Vídeo (Shift+N)">
                    <Path Fill="#FFFFFF"
                          Stretch="Uniform"
                          Width="15" Height="15"
                          Data="M 5,5 L 15,12 L 5,19 Z M 16,5 H 18.5 V 19 H 16 Z"/>
                </Border>

                <!-- Container de Áudio (Alto-falante + Slider Expansível no Hover) -->
                <StackPanel Name="VolumeHoverGroup" Orientation="Horizontal" VerticalAlignment="Center" Background="#01000000">
                    <Border Name="BtnMuteSpeaker" Width="38" Height="38" Background="#01000000" CornerRadius="19" Cursor="Hand" ToolTip="Mudo / Som (M)">
                        <Grid Width="20" Height="20">
                            <Path Name="IconSpeakerActive"
                                  Fill="#FFFFFF"
                                  Stretch="Uniform"
                                  Width="18" Height="17"
                                  Data="M3,9 V15 H7 L12,20 V4 L7,9 H3 Z M16.5,12 C16.5,10.23 15.48,8.71 14,7.97 V16.02 C15.48,15.29 16.5,13.77 16.5,12 Z M14,3.23 V5.29 C16.89,6.15 19,8.83 19,12 C19,15.17 16.89,17.85 14,18.71 V20.77 C18.01,19.86 21,16.28 21,12 C21,7.72 18.01,4.14 14,3.23 Z"/>
                            <Path Name="IconSpeakerMuted"
                                  Fill="#FF5252"
                                  Stretch="Uniform"
                                  Width="18" Height="17"
                                  Visibility="Collapsed"
                                  Data="M16.5,12 C16.5,10.23 15.48,8.71 14,7.97 V10.18 L16.45,12.63 C16.48,12.43 16.5,12.22 16.5,12 Z M19,12 C19,12.94 18.8,13.82 18.46,14.64 L19.97,16.15 C20.63,14.91 21,13.5 21,12 C21,7.72 18.01,4.14 14,3.23 V5.29 C16.89,6.15 19,8.83 19,12 Z M4.27,3 L3,4.27 L7.73,9 H3 V15 H7 L12,20 V13.27 L16.25,17.52 C15.58,18.04 14.83,18.45 14,18.7 V20.76 C15.38,20.45 16.63,19.81 17.69,18.95 L19.73,21 L21,19.73 L12,10.73 L4.27,3 Z M12,4 L9.91,6.09 L12,8.18 V4 Z"/>
                        </Grid>
                    </Border>

                    <!-- Slider de Volume Expansível -->
                    <Border Name="VolumeSliderExpandContainer"
                            Width="0"
                            Height="36"
                            ClipToBounds="True"
                            VerticalAlignment="Center">
                        <Grid Name="VolumeSliderHitGrid"
                              Width="68"
                              Height="36"
                              Margin="2,0,8,0"
                              Background="#01000000"
                              Cursor="Hand"
                              VerticalAlignment="Center">
                            <Border Height="3.5"
                                    CornerRadius="1.75"
                                    Background="#4DFFFFFF"
                                    VerticalAlignment="Center"/>
                            <Border Name="VolumeSliderFillBar"
                                    Height="3.5"
                                    CornerRadius="1.75"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Width="50"
                                    Background="#FFFFFF"/>
                            <Canvas VerticalAlignment="Center" Height="16" IsHitTestVisible="False">
                                <Ellipse Name="VolumeSliderThumb"
                                         Width="12"
                                         Height="12"
                                         Fill="#FFFFFF"
                                         Canvas.Top="2"
                                         Canvas.Left="44"/>
                            </Canvas>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Rótulo de Tempo Atual / Total -->
                <TextBlock Name="TxtTimeDisplay"
                           Text="0:00 / 0:00"
                           Foreground="#DDDDDD"
                           FontFamily="Segoe UI, Roboto"
                           FontSize="12.5"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"/>
            </StackPanel>

            <!-- Controles da Direita: Badge Qualidade, Engrenagem, Modo Teatro e Tela Cheia -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Name="BadgeQualityPill"
                        Background="#26FFFFFF"
                        CornerRadius="4"
                        Padding="6,2"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        ToolTip="Clique para alterar a qualidade">
                    <TextBlock Name="TxtQualityBadge"
                               Text="720p HD"
                               Foreground="#FFFFFF"
                               FontFamily="Segoe UI Semibold"
                               FontSize="10.5"/>
                </Border>

                <!-- Botão de Engrenagem (Qualidade / Velocidade) -->
                <Border Name="BtnSettingsGear" Width="38" Height="38" Background="#01000000" CornerRadius="19" Cursor="Hand" ToolTip="Configurações de Qualidade e Velocidade">
                    <Path Fill="#FFFFFF"
                          Stretch="Uniform"
                          Width="17" Height="17"
                          Data="M19.14,12.94 C19.18,12.64 19.2,12.33 19.2,12 C19.2,11.68 19.18,11.36 19.13,11.06 L21.16,9.48 C21.34,9.34 21.39,9.07 21.28,8.87 L19.36,5.55 C19.24,5.33 18.99,5.26 18.77,5.33 L16.38,6.29 C15.88,5.91 15.35,5.59 14.76,5.35 L14.4,2.81 C14.36,2.57 14.16,2.4 13.92,2.4 H10.08 C9.84,2.4 9.65,2.57 9.61,2.81 L9.25,5.35 C8.66,5.59 8.12,5.92 7.63,6.29 L5.24,5.33 C5.02,5.25 4.77,5.33 4.65,5.55 L2.74,8.87 C2.62,9.08 2.66,9.34 2.86,9.48 L4.89,11.06 C4.84,11.36 4.8,11.69 4.8,12 C4.8,12.31 4.82,12.64 4.87,12.94 L2.84,14.52 C2.66,14.66 2.61,14.93 2.72,15.13 L4.64,18.45 C4.76,18.67 5.01,18.74 5.23,18.67 L7.62,17.71 C8.12,18.09 8.65,18.41 9.24,18.65 L9.6,21.19 C9.65,21.43 9.84,21.6 10.08,21.6 H13.92 C14.16,21.6 14.36,21.43 14.39,21.19 L14.75,18.65 C15.34,18.41 15.88,18.09 16.37,17.71 L18.76,18.67 C18.98,18.75 19.23,18.67 19.35,18.45 L21.27,15.13 C21.39,14.91 21.34,14.66 21.15,14.52 L19.14,12.94 Z M12,15.6 C10.02,15.6 8.4,13.98 8.4,12 C8.4,10.02 10.02,8.4 12,8.4 C13.98,8.4 15.6,10.02 15.6,12 C15.6,13.98 13.98,15.6 12,15.6 Z"/>
                </Border>

                <!-- Modo Teatro -->
                <Border Name="BtnTheaterMode" Width="38" Height="38" Background="#01000000" CornerRadius="19" Cursor="Hand" ToolTip="Modo Teatro (T)">
                    <Path Fill="#FFFFFF"
                          Stretch="Uniform"
                          Width="18" Height="14"
                          Data="M19,6 H5 C3.9,6 3,6.9 3,8 V16 C3,17.1 3.9,18 5,18 H19 C20.1,18 21,17.1 21,16 V8 C21,6.9 20.1,6 19,6 Z M19,16 H5 V8 H19 V16 Z"/>
                </Border>

                <!-- Tela Cheia (Fullscreen) -->
                <Border Name="BtnFullscreen" Width="38" Height="38" Background="#01000000" CornerRadius="19" Cursor="Hand" ToolTip="Tela Cheia (F)">
                    <Path Name="IconFullscreen"
                          Fill="#FFFFFF"
                          Stretch="Uniform"
                          Width="17" Height="17"
                          Data="M7,14 H5 V19 H10 V17 H7 V14 Z M5,10 H7 V7 H10 V5 H5 V10 Z M17,17 H14 V19 H19 V14 H17 V17 Z M14,5 V7 H17 V10 H19 V5 H14 Z"/>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Grid>
